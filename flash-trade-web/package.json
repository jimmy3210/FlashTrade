{
  "name": "flash-trade-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build && cpy dist/** ../flash-trade-api/src/main/resources/static/admin --parents",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "crypto-js": "^4.2.0",
    "element-plus": "^2.14.8",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "cpy-cli": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  }
}
